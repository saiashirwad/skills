#!/usr/bin/env bash
# spawn <name> <brief.md> [--hard] [--cwd DIR] [--rift BRANCH]
# Creates an OpenCode session through its API, sends the brief through the API
# (never by typing into the TUI), then opens the session in a new Herdr tab to watch.
# --rift snapshots DIR (uncommitted changes included) and works on BRANCH there.
# Prints the job directory for `await`.
set -euo pipefail

usage() { echo "usage: spawn <name> <brief.md> [--hard] [--cwd DIR] [--rift BRANCH]" >&2; exit 64; }
[ $# -ge 2 ] || usage
name=$1 brief=$2
shift 2
model='{"providerID":"oai","id":"astralow"}' cwd=$PWD branch=
while [ $# -gt 0 ]; do
  case $1 in
    --hard) model='{"providerID":"openai","id":"gpt-6-astra","variant":"high"}' ;;
    --cwd) cwd=$(cd "$2" && pwd); shift ;;
    --rift) branch=$2; shift ;;
    *) usage ;;
  esac
  shift
done

[ "${HERDR_ENV:-}" = 1 ] || { echo "spawn: not inside Herdr (HERDR_ENV != 1)" >&2; exit 69; }
[[ $name =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "spawn: name must match [a-z][a-z0-9_-]*" >&2; exit 64; }
[ -s "$brief" ] || { echo "spawn: brief $brief is missing or empty" >&2; exit 66; }
if herdr agent get "$name" >/dev/null 2>&1; then
  echo "spawn: an agent named $name already exists; pick another name" >&2
  exit 65
fi

pick() { python3 -c 'import json,sys; d=json.load(sys.stdin)
for k in sys.argv[1].split("."): d=d[k]
print(d)' "$1"; }

job=$(mktemp -d "${TMPDIR:-/tmp}/delegate.$name.XXXXXX")
echo "$name" >"$job/name"

rift_note=
if [ -n "$branch" ]; then
  (cd "$cwd" && { command rift list . >/dev/null 2>&1 || command rift init >/dev/null; })
  ws=$(cd "$cwd" && command rift create --name "$name")
  git -C "$ws" switch -q -c "$branch"
  printf '%s\n%s\n' "$ws" "$branch" >"$job/rift"
  cwd=$ws
  rift_note="You are in a Rift (an isolated copy of the user's checkout) on branch $branch. Commit only files you changed; the user's uncommitted work is copied here too. Run \`bun install\` first if you need dependencies."
fi

{
  cat "$brief"
  cat <<EOF

---

$rift_note
Work alone: no subagents. Do not ask questions in chat; nobody is watching.
When finished, write your final report to $job/result.md, then create the empty file $job/DONE as your very last action.
If you cannot continue without a human (a decision, credentials, an approval), write what you need to $job/BLOCKED and stop.
EOF
} >"$job/brief.md"

create=$(python3 -c 'import json,sys; print(json.dumps({"title": sys.argv[1], "model": json.loads(sys.argv[2]), "location": {"directory": sys.argv[3]}}))' "$name" "$model" "$cwd")
sid=$(opencode api post /api/session --data "$create" | pick data.id)
echo "$sid" >"$job/session"

pane=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$cwd" --label "$name" --no-focus |
  pick result.root_pane.pane_id)
herdr agent start "$name" --kind opencode --pane "$pane" --timeout 60000 -- --session "$sid" >/dev/null ||
  echo "spawn: watcher tab failed to start; the job still runs in the OpenCode service" >&2

prompt=$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1]}))' "Read $job/brief.md and carry it out.")
opencode api post "/api/session/$sid/prompt" --data "$prompt" >/dev/null

echo "$job"
