#!/usr/bin/env bash
# spawn <name> <brief.md> [--model TIER] [--cwd DIR] [--rift BRANCH]
# Starts OpenCode through its API, or Claude Code through Herdr, in a new tab.
# TIER is a line in ../models (default: its first tier).
# --rift snapshots DIR (uncommitted changes included) and works on BRANCH there.
# Prints the job directory for `await`.
set -euo pipefail

usage() { echo "usage: spawn <name> <brief.md> [--model TIER] [--cwd DIR] [--rift BRANCH]" >&2; exit 64; }
[ $# -ge 2 ] || usage
name=$1 brief=$2
shift 2
tier= cwd=$PWD branch=
while [ $# -gt 0 ]; do
  case $1 in
    --model) tier=$2; shift ;;
    --cwd) cwd=$(cd "$2" && pwd); shift ;;
    --rift) branch=$2; shift ;;
    *) usage ;;
  esac
  shift
done

[ "${HERDR_ENV:-}" = 1 ] || { echo "spawn: not inside Herdr (HERDR_ENV != 1)" >&2; exit 69; }
[[ $name =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "spawn: name must match [a-z][a-z0-9_-]*" >&2; exit 64; }
[ -s "$brief" ] || { echo "spawn: brief $brief is missing or empty" >&2; exit 66; }
if herdr agent get "$name" >/dev/null 2>&1; then
  echo "spawn: an agent named $name already exists; pick another name" >&2
  exit 65
fi

models=$(dirname "$0")/../models
selector=$(grep -v '^#' "$models" | awk -v t="$tier" 'NF && (t == "" || $1 == t) {print $2; exit}')
[ -n "$selector" ] || { echo "spawn: no tier '$tier' in $models" >&2; exit 64; }
model=$(python3 -c 'import json,sys; pm, _, v = sys.argv[1].partition("#"); p, _, m = pm.partition("/")
print(json.dumps({"providerID": p, "id": m, **({"variant": v} if v else {})}))' "$selector")

pick() { python3 -c 'import json,sys; d=json.load(sys.stdin)
for k in sys.argv[1].split("."): d=d[k]
print(d)' "$1"; }

job=$(mktemp -d "${TMPDIR:-/tmp}/delegate.$name.XXXXXX")
echo "$name" >"$job/name"
echo "${tier:-default}" >"$job/tier"
echo "$cwd" >"$job/source"
backend=opencode
[ "${selector%%/*}" != claude ] || backend=claude
echo "$backend" >"$job/backend"

rift_note=
if [ -n "$branch" ]; then
  (cd "$cwd" && { command rift list . >/dev/null 2>&1 || command rift init >/dev/null 2>&1; })
  ws=$(cd "$cwd" && command rift create --name "$name" 2>/dev/null | tail -1)
  git -C "$ws" switch -q -c "$branch"
  printf '%s\n%s\n' "$ws" "$branch" >"$job/rift"
  cwd=$ws
  rift_note="You are in a Rift (an isolated copy of the user's checkout) on branch $branch. Commit only files you changed; the user's uncommitted work is copied here too. Run \`bun install\` first if you need dependencies."
fi

{
  cat "$brief"
  cat <<EOF

---

$rift_note
Work alone: no subagents. Do not ask questions in chat; nobody is watching.
When finished, write your report to $job/result.md. Start it with a \`## TL;DR\` section of at most 8 lines (the answer, decisions, anything surprising); put detail and citations below. Then create the empty file $job/DONE as your very last action.
If you cannot continue without a human (a decision, credentials, an approval), write what you need to $job/BLOCKED and stop.
EOF
} >"$job/brief.md"

if [ "$backend" = claude ]; then
  if [ -n "$branch" ]; then
    # Trust only the Rift this invocation created, never an arbitrary --cwd.
    python3 - "$ws" <<'PY'
import json, os, stat, sys, tempfile
path = os.path.expanduser("~/.claude.json")
try:
    with open(path) as f:
        config = json.load(f)
    mode = stat.S_IMODE(os.stat(path).st_mode)
except FileNotFoundError:
    config, mode = {}, 0o600
config.setdefault("projects", {}).setdefault(sys.argv[1], {})["hasTrustDialogAccepted"] = True
fd, temporary = tempfile.mkstemp(prefix=".claude.json.", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w") as f:
        os.fchmod(f.fileno(), mode)
        json.dump(config, f, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
  fi
  pane=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$cwd" --label "$name" --no-focus |
    pick result.root_pane.pane_id)
  herdr agent start "$name" --kind claude --pane "$pane" --timeout 60000 -- --model "${selector#*/}" --dangerously-skip-permissions >/dev/null
  # Keep spawn asynchronous; await observes the agent and the report files.
  nohup herdr agent prompt "$name" "Read $job/brief.md and carry it out." --wait >"$job/prompt.log" 2>&1 </dev/null &
  echo "$job"
  exit 0
fi

create=$(python3 -c 'import json,sys; print(json.dumps({"title": sys.argv[1], "model": json.loads(sys.argv[2]), "location": {"directory": sys.argv[3]}}))' "$name" "$model" "$cwd")
sid=$(opencode api post /api/session --data "$create" | pick data.id)
echo "$sid" >"$job/session"

pane=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$cwd" --label "$name" --no-focus |
  pick result.root_pane.pane_id)
herdr agent start "$name" --kind opencode --pane "$pane" --timeout 60000 -- --session "$sid" >/dev/null ||
  echo "spawn: watcher tab failed to start; the job still runs in the OpenCode service" >&2

prompt=$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1]}))' "Read $job/brief.md and carry it out.")
opencode api post "/api/session/$sid/prompt" --data "$prompt" >/dev/null

echo "$job"
