#!/usr/bin/env bash
# spawn <name> <brief.md> [--model TIER] [--cwd DIR] [--rift BRANCH]
# Starts an interactive Pi agent in a Herdr tab and submits the brief.
# TIER is a line in ../models (default: its first tier).
# --rift snapshots DIR (uncommitted changes included) and works on BRANCH there.
# Prints the job directory for `await`.
set -euo pipefail

usage() { echo "usage: spawn <name> <brief.md> [--model TIER] [--cwd DIR] [--rift BRANCH]" >&2; exit 64; }
[ $# -ge 2 ] || usage
name=$1 brief=$2
shift 2
tier='' cwd=$PWD branch=''
while [ $# -gt 0 ]; do
  case $1 in
    --model) tier=$2; shift ;;
    --cwd) cwd=$(cd "$2" && pwd); shift ;;
    --rift) branch=$2; shift ;;
    *) usage ;;
  esac
  shift
done

[ "${HERDR_ENV:-}" = 1 ] || { echo "spawn: not inside Herdr (HERDR_ENV != 1)" >&2; exit 69; }
[[ $name =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "spawn: name must match [a-z][a-z0-9_-]*" >&2; exit 64; }
[ -s "$brief" ] || { echo "spawn: brief $brief is missing or empty" >&2; exit 66; }
if herdr agent get "$name" >/dev/null 2>&1; then
  echo "spawn: an agent named $name already exists; pick another name" >&2
  exit 65
fi

models=$(dirname "$0")/../models
selector=$(grep -v '^#' "$models" | awk -v t="$tier" 'NF && (t == "" || $1 == t) {print $2; exit}')
[ -n "$selector" ] || { echo "spawn: no tier '$tier' in $models" >&2; exit 64; }
pick() { python3 -c 'import json,sys; d=json.load(sys.stdin)
for k in sys.argv[1].split("."): d=d[k]
print(d)' "$1"; }

job=$(mktemp -d "${TMPDIR:-/tmp}/delegate.$name.XXXXXX")
echo "$name" >"$job/name"
echo "${tier:-default}" >"$job/tier"
echo "$cwd" >"$job/source"

rift_note=
if [ -n "$branch" ]; then
  (cd "$cwd" && { command rift list . >/dev/null 2>&1 || command rift init >/dev/null 2>&1; })
  ws=$(cd "$cwd" && command rift create --name "$name" 2>/dev/null | tail -1)
  git -C "$ws" switch -q -c "$branch"
  printf '%s\n%s\n' "$ws" "$branch" >"$job/rift"
  cwd=$ws
  rift_note="You are in a Rift (an isolated copy of the user's checkout) on branch $branch. Commit only files you changed; the user's uncommitted work is copied here too. Run \`bun install\` first if you need dependencies."
fi

{
  cat "$brief"
  cat <<EOF

---

$rift_note
Work alone: no subagents. Do not ask questions in chat; nobody is watching.
When finished, write your report to $job/result.md. Start it with a \`## TL;DR\` section of at most 8 lines (the answer, decisions, anything surprising); put detail and citations below. Then create the empty file $job/DONE as your very last action.
If you cannot continue without a human (a decision, credentials, an approval), write what you need to $job/BLOCKED and stop.
EOF
} >"$job/brief.md"

tab=$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$cwd" --label "$name" --no-focus)
printf '%s' "$tab" | pick result.tab.tab_id >"$job/tab"
pane=$(printf '%s' "$tab" | pick result.root_pane.pane_id)
echo "$pane" >"$job/pane"
started=$(herdr agent start "$name" --kind pi --pane "$pane" --timeout 60000 -- \
  --model "$selector" --name "$name" --session-dir "$job/sessions")
printf '%s' "$started" | pick result.agent.agent_session.value >"$job/session"

# Record the job before submission: a prompt error may still have delivered it.
echo "job: $job" >&2
herdr agent prompt "$pane" "Read $job/brief.md and carry it out." >/dev/null

echo "$job"
