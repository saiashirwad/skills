#!/usr/bin/env bash
# await <job> [timeout-minutes]; exit 0 done, 2 blocked, 3 stalled, 4 timeout, 5 hung.
set -uo pipefail
. "$(dirname "$0")/lib.sh"
dir=$(job "${1:?usage: await <job> [timeout-minutes]}") || exit 64
deadline=$(($(date +%s) + ${2:-60} * 60))
name=$(cat "$dir/name")
report() {
  echo "== $name: $1 ($dir)"
  tldr "$dir"
  [ ! -f "$dir/BLOCKED" ] || { echo '== needs:'; cat "$dir/BLOCKED"; }
}
# Session growth records completed messages/tool calls, not live streaming tokens.
activity() { wc -c <"$(cat "$dir/session")" 2>/dev/null || true; }
idle=0 last=$(activity) moved=$(date +%s)
while :; do
  case $(status "$dir") in
    done) report 'done'; exit 0 ;;
    finished) report finished; exit 0 ;;
    blocked) report 'blocked; read its tab'; exit 2 ;;
    running)
      idle=0
      now=$(activity)
      if [ "$now" != "$last" ]; then last=$now moved=$(date +%s); fi
      if [ $(($(date +%s) - moved)) -ge 900 ]; then
        report "possibly hung: no session activity for 15 minutes; read the tab before interrupting with herdr agent send-keys $(cat "$dir/pane") esc"
        exit 5
      fi ;;
    stopped) idle=$((idle + 1)) ;;
    *) idle=0 ;; # Detection failure is not proof the agent stopped.
  esac
  [ "$idle" -lt 3 ] || { report 'stalled: idle without DONE'; exit 3; }
  [ "$(date +%s)" -lt "$deadline" ] || { report timed-out; exit 4; }
  sleep 10
done
