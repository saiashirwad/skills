#!/usr/bin/env bash
# claim <ticket>: assign the ticket to me; fail if someone has it.
. "$(dirname "$0")/lib.sh"

[[ $# -eq 1 ]] || die 'usage: claim <ticket>'
n=$(num "$1")

who=$(gh api "$R/issues/$n" --jq '.assignees | map(.login) | join(", ")')
[[ -z $who ]] || die "already claimed by $who"
gh issue edit "$n" --add-assignee @me >/dev/null
link "$n"
