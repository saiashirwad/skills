#!/usr/bin/env bash
# ticket <map> <type> <title> < body: create a ticket on the map; print its link.
. "$(dirname "$0")/lib.sh"

[[ $# -eq 3 ]] || die 'usage: ticket <map> <research|prototype|grilling|task> <title> < body'
map=$(num "$1") type=$2 title=$3
case $type in
  research|prototype|grilling|task) ;;
  *) die "unknown type: $type" ;;
esac

label "wayfinder:$type"
n=$(num "$(gh issue create --title "$title" --label "wayfinder:$type" --body-file -)")
gh api "$R/issues/$map/sub_issues" -F sub_issue_id="$(id "$n")" >/dev/null
link "$n"
