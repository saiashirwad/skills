#!/usr/bin/env bash
# block <ticket> <blocker...>: mark the ticket as blocked by each blocker.
. "$(dirname "$0")/lib.sh"

[[ $# -ge 2 ]] || die 'usage: block <ticket> <blocker...>'
n=$(num "$1")
shift

for b in "$@"; do
  gh api "$R/issues/$n/dependencies/blocked_by" -F issue_id="$(id "$b")" >/dev/null
  echo "$(link "$n") is blocked by $(link "$b")"
done
