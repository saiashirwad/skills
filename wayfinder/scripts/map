#!/usr/bin/env bash
# map <title> <destination>: create a map issue; print its link.
. "$(dirname "$0")/lib.sh"

[[ $# -eq 2 ]] || die 'usage: map <title> <destination>'

label wayfinder:map 0e8a16
url=$(gh issue create --title "$1" --label wayfinder:map --body-file - <<EOB
## Destination
$2

## Notes

## Decisions so far

## Not yet specified

## Out of scope
EOB
)
link "$url"
