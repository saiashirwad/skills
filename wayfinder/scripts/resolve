#!/usr/bin/env bash
# resolve <ticket> <gist> [--out-of-scope] < answer: comment the answer, close the
# ticket, and add a line to the map's Decisions so far (or Out of scope).
. "$(dirname "$0")/lib.sh"

[[ $# -ge 2 && $# -le 3 ]] || die 'usage: resolve <ticket> <gist> [--out-of-scope] < answer'
n=$(num "$1") gist=$2 section='Decisions so far' reason=completed
case ${3:-} in
  '') ;;
  --out-of-scope) section='Out of scope' reason='not planned' ;;
  *) die "unknown flag: $3" ;;
esac

map=$(gh api "$R/issues/$n/parent" --jq .number 2>/dev/null) || die "ticket $n has no map"
answer=$(cat)
[[ -n $answer ]] || answer=$gist

gh issue comment "$n" --body "$answer" >/dev/null
gh issue close "$n" --reason "$reason" 2>/dev/null ||
  die "could not close $n; run: gh issue close $n --reason '$reason'"

# Insert the line at the end of the section, before trailing blank lines.
head="## $section" line="- $(link "$n"): $gist"
export head line
gh api "$R/issues/$map" --jq '.body // "" | gsub("\r"; "")' |
  awk '
    function flush () { if (inside) print ENVIRON["line"]; inside = 0; for (; blanks; blanks--) print "" }
    /^## / { flush(); inside = ($0 == ENVIRON["head"]) }
    /^[[:space:]]*$/ { blanks++; next }
    { for (; blanks; blanks--) print ""; print }
    END { flush() }' |
  gh issue edit "$map" --body-file - >/dev/null
link "$n"
